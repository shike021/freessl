# ============================================================
# FreeSSL Production Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# -- Domain --
# Your production domain (used in nginx, SSL certs, etc.)
DOMAIN=your-domain.com

# -- Docker Image Tag --
TAG=latest

# -- Database --
MYSQL_ROOT_PASSWORD=strong-root-password-here
MARIADB_USER=freessl
MARIADB_PASS=strong-db-password-here
MARIADB_DB=freessl

# -- Flask --
SECRET_KEY=generate-a-long-random-secret-key-here
ENCRYPTION_KEY=generate-a-32-byte-fernet-key-here

# -- Email --
EMAIL_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@your-domain.com

# -- Frontend API URLs (build-time, embedded in static files) --
VUE_APP_API_URL=https://your-domain.com/api
VUE_APP_API_BASE_URL=https://your-domain.com/api
