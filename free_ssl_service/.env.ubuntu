# FreeSSL Environment Configuration
# Copy this file to .env and fill in the values

# Database Configuration
MARIADB_PASS=freessl_password
MYSQL_ROOT_PASSWORD=root_password

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Secret Key (IMPORTANT: Change this in production!)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# SMTP Configuration (Email)
# For QQ Enterprise Email: smtp.exmail.qq.com, port 587
# For Alibaba Cloud: smtpdm.aliyun.com, port 465 (SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@freessl.com
EMAIL_BASE_URL=https://freessl.shi021.cn

# Encryption Key for sensitive data (must be 32 bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-32-bytes-long
